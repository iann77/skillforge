# ========================================================
# SKILLFORGE ENVIRONMENT CONFIGURATION
# ========================================================
# Petunjuk: Salin file ini menjadi .env.local untuk pengembangan lokal.
# Jangan pernah commit nilai rahasia (.env.local) ke git repository.

# URL Project Supabase Anda (Didapat dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Aman untuk browser client / RLS aktif)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Hanya untuk server admin backend/seed - JANGAN diekspos ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL Aplikasi (digunakan untuk redirect callback email auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
